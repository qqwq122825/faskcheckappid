{
  "schema_version": 1,
  "updated_on": "2026-11-17",
  "purpose": "Protocol/result classification reference; not an official Apple error-code dictionary",
  "loaded_by_runtime": false,
  "runtime_display_implementation": "../task_status.py",
  "dimensions": [
    "protocol",
    "stage",
    "http",
    "apple_ec",
    "status",
    "kind",
    "password_verified",
    "user_reported_account_state"
  ],
  "principles": [
    "Keep user-reported frozen state separate from conclusions supported by this response",
    "Classify account outcomes from explicit built-in English Apple reasons, not shared numeric error codes",
    "Keep unmatched Apple responses undetermined instead of guessing from ec",
    "HTTP 5xx and transport failures do not establish account state",
    "Init acceptance is not password verification or completed service login"
  ],
  "display_groups": {
    "valid": {
      "label": "密码正确",
      "statuses": [
        "valid"
      ],
      "conditional_status": {
        "status": "needs_setup",
        "password_verified": true
      }
    },
    "wrong_password": {
      "label": "错误",
      "english_reasons": [
        "Enter the correct password for this Apple Account.",
        "Your account information was entered incorrectly."
      ]
    },
    "need_2fa": {
      "label": "双重",
      "statuses": [
        "need_2fa"
      ],
      "also_count_as_valid": false
    },
    "locked": {
      "label": "锁定",
      "english_reasons": [
        "This Apple Account has been locked for security reasons."
      ]
    },
    "timeout": {
      "label": "请重试",
      "kind": "timeout",
      "statuses": [
        "timeout"
      ],
      "english_reasons": [
        "Unable to sign you in to your Apple Account. Try again later."
      ],
      "automatic_retry": "uses the configured retry count"
    },
    "undetermined": {
      "label": "其他错误",
      "default": true,
      "examples": [
        "credentials_rejected",
        "server_error",
        "network_error",
        "interrupted"
      ]
    },
    "invalid": {
      "label": "未激活",
      "english_reasons": [
        "This Apple Account is not active."
      ],
      "meaning": "reserved for explicit invalid-account verdicts and historical exports"
    },
    "not_found": {
      "label": "不存在",
      "english_reasons": [
        "The account does not exist."
      ]
    }
  },
